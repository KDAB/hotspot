{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "dev",
      "description": "Preset for developers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": "-g -fsanitize=address,undefined",
        "CMAKE_C_FLAGS_DEBUG": "-g -fsanitize=address,undefined"
      }
    },
    {
      "name": "dev-asan",
      "displayName": "dev with sanitizers",
      "description": "Preset for developers with asan and ubsan enabled",
      "inherits": [
        "dev",
        "asan"
      ]
    },
    {
      "name": "dev-clazy",
      "displayName": "clazy with sanitizers",
      "description": "Preset for compiling with clang/clazy and asan and ubsan enabled",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clazy",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_FLAGS": "-Xclang -plugin-arg-clazy -Xclang level0,level1,level2,no-strict-iterators,no-ctor-missing-parent-argument -Werror",
        "CMAKE_C_FLAGS": "-Werror"
      },
      "inherits": [
        "dev-asan"
      ]
    },
    {
      "name": "dev-opt",
      "displayName": "dev with optimizations",
      "description": "Preset for developers with compiler optimizations enabled",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS" : "-DQT_FORCE_ASSERTS -DQT_MESSAGELOGCONTEXT"
      },
      "inherits": [
        "dev"
      ]
    },
    {
      "name": "dev-opt-asan",
      "displayName": "dev with optimizations and sanitizers",
      "description": "Preset for developers with compiler optimizations and sanitizers enabled",
      "inherits": [
        "dev-opt",
        "asan"
      ]
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "${sourceDir}/3rdparty/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-triplets/",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "dev-vcpkg",
      "displayName": "dev with vcpkg",
      "description": "Preset for developers, with dependencies built by vcpkg",
      "inherits": [
        "dev",
        "vcpkg"
      ]
    },
    {
      "name": "rel-vcpkg",
      "displayName": "release with vcpkg",
      "description": "Release build, with dependencies built by vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "OFF"
      },
      "inherits": [
        "vcpkg"
      ]
    },
    {
      "name": "dev-vcpkg-static",
      "displayName": "dev with vcpkg (static)",
      "description": "Preset for developers, with dependencies built by vcpkg using the static triplet",
      "inherits": [
        "dev-vcpkg"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "rel-vcpkg-static",
      "displayName": "release with vcpkg (static)",
      "description": "Release build, with dependencies built by vcpkg using the static triplet",
      "inherits": [
        "rel-vcpkg"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-asan",
      "configurePreset": "dev-asan"
    },
    {
      "name": "dev-opt",
      "configurePreset": "dev-opt"
    },
    {
      "name": "dev-opt-asan",
      "configurePreset": "dev-opt-asan"
    },
    {
      "name": "dev-clazy",
      "configurePreset": "dev-clazy"
    },
    {
      "name": "dev-vcpkg",
      "configurePreset": "dev-vcpkg"
    },
    {
      "name": "rel-vcpkg",
      "configurePreset": "rel-vcpkg"
    },
    {
      "name": "dev-vcpkg-static",
      "configurePreset": "dev-vcpkg-static"
    },
    {
      "name": "rel-vcpkg-static",
      "configurePreset": "rel-vcpkg-static"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error", "stopOnFailure": true}
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "inherits": "base"
    },
    {
      "name": "dev-asan",
      "configurePreset": "dev-asan",
      "inherits": "base"
    },
    {
      "name": "dev-opt",
      "configurePreset": "dev-opt",
      "inherits": "base"
    },
    {
      "name": "dev-opt-asan",
      "configurePreset": "dev-opt-asan",
      "inherits": "base"
    },
    {
      "name": "dev-clazy",
      "configurePreset": "dev-clazy",
      "inherits": "base"
    },
    {
      "name": "dev-vcpkg",
      "configurePreset": "dev-vcpkg",
      "inherits": "base"
    },
    {
      "name": "dev-vcpkg-static",
      "configurePreset": "dev-vcpkg-static",
      "inherits": "base"
    }
  ]
}
